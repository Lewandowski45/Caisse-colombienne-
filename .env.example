# Copiez ce fichier en ".env" et remplissez les valeurs.
# Ne committez JAMAIS le fichier ".env" réel.

# Clé secrète Flask (sessions, CSRF). Générez-la avec :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Compte super_admin (le propriétaire) créé automatiquement au tout premier
# lancement (uniquement si la table utilisateurs est vide).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Passer à 1 uniquement en développement local, jamais en production.
FLASK_DEBUG=0

# Chaîne de connexion Postgres (Supabase).
#
# IMPORTANT pour Vercel (et tout hébergeur IPv4-only) : la connexion directe
# (db.xxx.supabase.co:5432) est en IPv6 et NE FONCTIONNERA PAS depuis Vercel.
# Utilise le "Shared Pooler" en mode "Transaction" (port 6543, IPv4) :
#   Dashboard Supabase > bouton "Connect" en haut du projet > onglet
#   "Transaction pooler" > copie l'URI, remplace [YOUR-PASSWORD].
# Le nom d'utilisateur change aussi dans ce mode : postgres.<ref-du-projet>
# au lieu de simplement postgres.
DATABASE_URL=postgresql://postgres.wadfdlorhrijbzzgpalh:[VOTRE-MOT-DE-PASSE]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Code que les vrais membres doivent connaître pour pouvoir s'inscrire.
# Sans lui, l'inscription est ouverte à quiconque connaît l'URL.
INSCRIPTION_CODE=change-moi

